# Required by SEC EDGAR's fair-access policy: identify requests with a real
# name and contact email. See https://www.sec.gov/os/webmaster-faq#developers
EDGAR_USER_AGENT="Your Name your.email@example.com"

# Model used by screener/analyze_filing.py via Ollama. Keep this small
# (1-3B class) so it runs on a free GitHub Actions runner.
OLLAMA_MODEL="llama3.2:3b"
